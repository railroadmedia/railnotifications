{
  "name": "railroad/railnotifications",
  "description": "Laravel notification system using entities",
  "license": "MIT",
  "prefer-stable": true,
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.9",
    "guzzlehttp/guzzle": "^7.2",
    "kreait/firebase-php": "^6.3",
    "doctrine/dbal": "^3.0",
    "doctrine/annotations": "^2.0",
    "symfony/dom-crawler": "^6.0",
    "railroad/doctrine": "3.0.*",
    "railroad/doctrine-array-hydrator": "3.0.*",
    "jms/serializer": "^3.0",
    "ext-redis": "*",
    "ext-pdo": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0.1",
    "phpunit/php-code-coverage": "^11.0.1",
    "orchestra/testbench": "^9.2"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/railroadmedia/laravel-apidoc-generator"
    }
  ],
  "autoload": {
    "psr-4": {
      "Railroad\\Railnotifications\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Railroad\\Railnotifications\\Tests\\": "tests/"
    }
  }
}
